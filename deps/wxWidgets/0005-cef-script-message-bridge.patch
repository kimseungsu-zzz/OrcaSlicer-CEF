+bool ClientHandler::OnSetFocus(CefRefPtr<CefBrowser> browser, FocusSource WXUNUSED(source))
+{
+#ifdef __WXGTK__
+    const CefWindowHandle handle = browser->GetHost()->GetWindowHandle();
+    XWindowAttributes attributes{};
+    Display* display = wxGetX11Display();
+    if (handle && XGetWindowAttributes(display, handle, &attributes) &&
+        attributes.map_state == IsViewable) {
+        XSetInputFocus(display, handle, RevertToParent, CurrentTime);
+        XFlush(display);
+    }
+#endif
+    return false;
+}
